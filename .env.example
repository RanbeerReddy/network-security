# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGO_DB_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?appName=Cluster0

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=https://dagshub.com/your_username/your_repo.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_mlflow_password

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# DagShub Token (if needed)
DAGSHUB_TOKEN=your_dagshub_token

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Other configurations
# Add any other environment-specific variables here